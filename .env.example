# Copy to .env and fill in real values. .env is gitignored — never commit it.
# The app reads these via src/config/env.js and refuses to start if a required
# one is missing (fail-fast, so a misconfigured server never runs half-broken).

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=local            # local | dev | production
PORT=5001
LOG_LEVEL=info            # error | warn | info | debug

# ── Database (required) ────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/kehilapp

# ── Auth (required) ────────────────────────────────────────
# Long random string. Anyone who has it can forge tokens — treat as a password.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── File storage / AWS S3 (required) ───────────────────────
BUCKET_NAME=your-bucket-name
BUCKET_REGION=eu-central-1
BUCKET_ACCESS_KEY=your-access-key
BUCKET_SECRET_ACCESS_KEY=your-secret-key

# ── CORS (recommended in production) ───────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Left empty in development, localhost is allowed automatically.
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
