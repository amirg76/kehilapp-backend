{
  "env": {
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:eslint-comments/recommended",
    "plugin:jest/recommended",
    "plugin:promise/recommended",
    "prettier"
  ],
  "parser": "espree",
  "plugins": ["eslint-comments", "jest", "promise", "import", "prettier"],
  "rules": {
    "prettier/prettier": "error",
    "no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": true,
        "variables": true
      }
    ],
    "import/no-extraneous-dependencies": "off"
  },
  "settings": {
    "import/resolver": {
      "alias": {
        "map": [
          ["@root", "."],
          ["@apps", "./src/apps"],
          ["@config", "./src/config"],
          ["@errors", "./src/errors"],
          ["@middlewares", "./src/middlewares"],
          ["@services", "./src/services"],
          ["@validations", "./src/validations"],
          ["@categories", "./src/apps/categories"],
          ["@messages", "./src/apps/messages"],
          ["@users", "./src/apps/users"]
        ]
      },
      "node": {
        "extensions": [".js", ".json"]
      }
    }
  }
}
