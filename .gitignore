# dependencies
/node_modules

# env files
.env
.env.*
!.env.example

# secrets and keys — nothing here exists today, and nothing should ever be able
# to stage by accident either.
secrets/
prod.env
*.pem
*.key
*.p12
*credentials*.json
id_rsa
# `token.json` is the name every OAuth helper and CLI writes its refresh token
# to, and it does not match `*credentials*.json`. The admin repo has carried this
# line all along; this repo and the front did not, so of the three repos that
# ship together only one was covered. Verified with a real decoy file on disk
# (`git check-ignore -v token.json`), not against a pattern — nothing of the sort
# exists in this tree, and the point is that it can no longer arrive by accident.
token*.json

# misc
.DS_Store
.vscode

# logs
/src/logs
# Any log file, wherever it lands. /src/logs alone covered the directory the app
# writes to and nothing else — and a log file is exactly where a secret leaks
# without anyone reviewing the diff.
*.log
# Cygwin/MSYS crash dumps — a tool crashed here once and left this behind.
*.stackdump

# test output
coverage/
